# Anthropic API Key for Claude
ANTHROPIC_API_KEY=sk-ant-...

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_WEBHOOK_SECRET=optional_webhook_secret
# TELEGRAM_CHAT_ID is no longer required after the Postgres migration —
# chat-id → user mapping lives in the `channel_identities` table.

# Postgres
DATABASE_URL=postgres://ironclaude:ironclaude@localhost:5432/ironclaude

# Encryption key for OAuth tokens stored in integration_tokens (AES-GCM).
# Generate with: openssl rand -base64 32
INTEGRATION_TOKEN_KEY=

# Session cookie signing secret for the web onboarding flow.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Sentry DSN (optional — leave empty to disable).
SENTRY_DSN=

# Supabase (hosted Postgres + Auth). Create a project at https://supabase.com/dashboard,
# enable phone auth in Authentication > Providers (uses Twilio under the hood — supply your
# Twilio creds in the Supabase dashboard, not here).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API (for voice transcription)
GEMINI_API_KEY=...

# Cron Job Authentication
CRON_SECRET=random_secret_for_cron_auth

# Timezone (IANA format)
TIMEZONE=America/New_York

# Weight unit for display (lbs or kg, default: lbs)
# WEIGHT_UNIT=lbs

# Git commit identity (optional - for data repo commits)
# GIT_COMMIT_EMAIL=coach@fitness-bot.local
# GIT_COMMIT_NAME=Fitness Coach

# ─────────────────────────────────────────────────────────────────────────────
# Device Integrations (optional)
# ─────────────────────────────────────────────────────────────────────────────

# Whoop Integration
# Get these from https://developer.whoop.com after creating an app
# WHOOP_CLIENT_ID=your_client_id
# WHOOP_CLIENT_SECRET=your_client_secret
# WHOOP_WEBHOOK_SECRET=optional_webhook_verification_secret (HMAC secret)
# Note: Whoop tokens are stored encrypted in the integration_tokens table.
# Whoop user_id → IronClaude user_id lookup happens via integration_tokens.external_user_id,
# so the WHOOP_USER_ID env var is no longer needed.
